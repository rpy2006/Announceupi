<!-- FILE: app/src/main/res/values-night/themes.xml  (DARK overrides) -->

<resources>

    <style name="Theme.AnnounceUPI" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/bottom_bar_dark</item>

        <!-- System window background -->
        <item name="android:colorBackground">@color/bg_dark</item>

        <!-- Material attr overrides -->
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnBackground">@color/text_primary_dark</item>

        <!-- Custom attrs -->
        <item name="colorSurfaceStroke">@color/stroke_dark</item>
        <item name="colorSecondaryText">@color/text_secondary_dark</item>
        <item name="colorTertiaryText">@color/text_tertiary_dark</item>
        <item name="colorBottomBar">@color/bottom_bar_dark</item>

    </style>

</resources>
