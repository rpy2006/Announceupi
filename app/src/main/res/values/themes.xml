<!-- FILE: app/src/main/res/values/themes.xml  (LIGHT / default) -->

<resources>

    <style name="Theme.AnnounceUPI" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/surface_light</item>

        <!--
            android:colorBackground = system window background colour
            (used by ?android:attr/colorBackground in layouts)
        -->
        <item name="android:colorBackground">@color/bg_light</item>

        <!--
            Material attrs — colorSurface / colorOnBackground are already
            declared by Material so we just override their values here.
        -->
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnBackground">@color/text_primary_light</item>

        <!-- Our custom attrs (declared in attrs.xml) -->
        <item name="colorSurfaceStroke">@color/stroke_light</item>
        <item name="colorSecondaryText">@color/text_secondary_light</item>
        <item name="colorTertiaryText">@color/text_tertiary_light</item>
        <item name="colorBottomBar">@color/bottom_bar_light</item>

        <!-- Material card default style -->
        <item name="materialCardViewStyle">@style/CardStyle</item>

    </style>

    <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorSurfaceStroke</item>
        <item name="strokeWidth">1dp</item>
    </style>


    <!-- Splash screen theme — always light, no action bar, fixed #E8E8E8 bg -->
    <style name="Theme.AnnounceUPI.Splash" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">#E8E8E8</item>
        <item name="android:statusBarColor">#E8E8E8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#E8E8E8</item>
        <item name="android:windowFullscreen">false</item>
    </style>

</resources>
