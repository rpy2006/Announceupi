<?xml version="1.0" encoding="utf-8"?>
<!-- FILE: app/src/main/res/layout/item_transaction.xml -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorSurfaceStroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Avatar circle -->
        <TextView
            android:id="@+id/tvTxnAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="P"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#3DDC84"
            android:background="@drawable/circle_green_bg"
            android:layout_marginEnd="14dp"/>

        <!-- Source + date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTxnSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PhonePe"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnBackground"/>

            <TextView
                android:id="@+id/tvTxnDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09 Mar 2026"
                android:textSize="11sp"
                android:textColor="?attr/colorTertiaryText"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- Amount + time -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="10dp">

            <TextView
                android:id="@+id/tvTxnAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹500"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnBackground"/>

            <TextView
                android:id="@+id/tvTxnTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:30 PM"
                android:textSize="11sp"
                android:textColor="?attr/colorTertiaryText"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- Delete button -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnDeleteTxn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            app:srcCompat="@drawable/ic_delete"
            app:tint="#FF5252"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
